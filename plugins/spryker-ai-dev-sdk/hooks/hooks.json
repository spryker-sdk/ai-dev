{
    "description": "Enforcement hooks for the project-starter and demo-prep wizard runs: the static data gate runs before any docker/sdk rebuild or data:import and denies on a finding; a rebuild runs without a prompt at first setup, on a demo clone or under the person's standing approval, and asks otherwise; data:import is never asked. A step cannot be marked done while the gate fails or its evidence file is missing, installed skill copies are read-only, and every rebuild is counted. Sub-agent prompts must name their tooling, owning skill and work class. Shell writes into project files, staging and commits the person did not ask for, deletions git cannot restore and changes while a question is unanswered are denied. An autonomous run cannot end its turn with steps open. Local hosts are driven through Claude in Chrome, not the built-in browser.",
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "command -v php >/dev/null 2>&1 && exec php \"${CLAUDE_PLUGIN_ROOT}/hooks/gate-docker-sdk.php\" || exit 0",
                        "timeout": 120
                    },
                    {
                        "type": "command",
                        "command": "command -v php >/dev/null 2>&1 && exec php \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-bash.php\" || exit 0",
                        "timeout": 30
                    }
                ]
            },
            {
                "matcher": "Edit|Write|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "command -v php >/dev/null 2>&1 && exec php \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-files.php\" || exit 0",
                        "timeout": 120
                    }
                ]
            },
            {
                "matcher": "Agent|Task",
                "hooks": [
                    {
                        "type": "command",
                        "command": "command -v php >/dev/null 2>&1 && exec php \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-agent.php\" || exit 0",
                        "timeout": 15
                    }
                ]
            },
            {
                "matcher": "Skill",
                "hooks": [
                    {
                        "type": "command",
                        "command": "command -v php >/dev/null 2>&1 && exec php \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-skill.php\" || exit 0",
                        "timeout": 15
                    }
                ]
            },
            {
                "matcher": "mcp__Claude_Browser__.*|mcp__claude-in-chrome__javascript_tool",
                "hooks": [
                    {
                        "type": "command",
                        "command": "command -v php >/dev/null 2>&1 && exec php \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-browser.php\" || exit 0",
                        "timeout": 15
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "command -v php >/dev/null 2>&1 && exec php \"${CLAUDE_PLUGIN_ROOT}/hooks/count-rebuild.php\" || exit 0",
                        "timeout": 15
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "command -v php >/dev/null 2>&1 && exec php \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-stop.php\" || exit 0",
                        "timeout": 20
                    }
                ]
            }
        ]
    }
}
