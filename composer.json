{
    "name": "spryker-sdk/ai-dev",
    "type": "library",
    "description": "AiDev module",
    "license": "proprietary",
    "require": {
        "nikic/php-parser": ">=5.0",
        "php": ">=8.3",
        "php-mcp/server": "^3.3",
        "spryker/guzzle": ">=2.0.0",
        "spryker/kernel": ">=3.30.0",
        "spryker/module-finder": ">=1.0.0",
        "spryker/oms": ">=8.0.0",
        "spryker/propel-orm": ">=1.8.0",
        "spryker/sales": ">=11.0.0",
        "spryker/symfony": ">=3.0.0",
        "spryker/transfer": ">=3.27.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1.0",
        "spryker-sdk/phpstan-spryker": "dev-feature/frw-10644/master-upgraded-phpstan",
        "spryker/code-sniffer": ">=0.17.30",
        "spryker/development": "*"
    },
    "autoload": {
        "psr-4": {
            "SprykerSdk\\": "src/SprykerSdk/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "cs-check": "phpcs -p -s --standard=vendor/spryker/code-sniffer/SprykerStrict/ruleset.xml src/",
        "architecture-check": "phpmd src/ text vendor/spryker/development/resources/phpmd/ruleset.xml --minimumpriority 2",
        "cs-fix": "phpcbf -p --standard=vendor/spryker/code-sniffer/SprykerStrict/ruleset.xml src/",
        "stan": "phpstan analyse src"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
